    { "source": "/en/about", "destination": "/?lang=en#entrevista", "permanent": false },
    { "source": "/pt/lab", "destination": "/#passatempos", "permanent": false },
    { "source": "/en/lab", "destination": "/?lang=en#passatempos", "permanent": false },
    { "source": "/pt/projects", "destination": "/#tecnologia", "permanent": false },
    { "source": "/en/projects", "destination": "/?lang=en#tecnologia", "permanent": false },

    { "source": "/pt/projects/segalas-ecommerce", "destination": "/#/materia/backend-ecommerce", "permanent": false },
    { "source": "/en/projects/segalas-ecommerce", "destination": "/?lang=en#/materia/backend-ecommerce", "permanent": false },
    { "source": "/pt/projects/ecommerce-front", "destination": "/#/materia/loja-b2b", "permanent": false },
